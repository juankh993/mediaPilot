# ============================================================
#  EJEMPLO DE CONFIGURACION — MediaPilot
# ============================================================
#  Este archivo es SOLO un ejemplo. NUNCA lo llenes con claves reales
#  ni lo subas al repo.
#
#  Uso:
#    1. Copiarlo como  .env.local   (Next.js lo carga solo)
#    2. Rellenar solo lo que vayas a usar
#    3. .env.local esta en .gitignore — no se versiona
#
#  Comando:  Copy-Item .env.example .env.local
# ============================================================


# ------------------------------------------------------------
# 1) APLICACION
# ------------------------------------------------------------
# Clave para firmar sesiones / cookies. Generar una aleatoria larga.
APP_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
APP_URL=http://localhost:3000


# ------------------------------------------------------------
# 2) WORKSPACE Y MOTOR
# ------------------------------------------------------------
# Carpeta de trabajo: guiones, material, musica y renders.
# Un workspace por canal o cliente.
WORKSPACE_DIR=./workspace

# Carpeta con los scripts de render:
#   reel.ps1, fix-loudness.ps1, tts-palabras.py,
#   buscar-unsplash.ps1, buscar-fotos.ps1
# Si se omite, se busca ./engine y luego ../scripts.
ENGINE_DIR=./engine


# ------------------------------------------------------------
# 3) YOUTUBE  (Google Cloud Console -> APIs & Services -> Credentials)
# ------------------------------------------------------------
# App OAuth2 de tipo "Desktop" (permite localhost en cualquier puerto).
# API a habilitar: YouTube Data API v3
# Scopes: youtube.upload, youtube.readonly
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx
# Si se omite, se usa <origen>/api/youtube/oauth/callback
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# NOTA: los tokens de cada usuario se guardan en data/accounts.json
# (gitignored). No hay refresh token en este archivo.


# ------------------------------------------------------------
# 4) INTELIGENCIA ARTIFICIAL
# ------------------------------------------------------------
# OpenRouter: chat principal (DeepSeek V4.1 Flash 1017)
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODELO=deepseek/deepseek-v4.1-flash-1017

# Google AI Studio: respaldo del chat (aistudio.google.com)
GOOGLE_AI_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODELO=gemini-3.5-flash


# ------------------------------------------------------------
# 5) FUENTES DE MATERIAL (las usan los scripts del motor)
# ------------------------------------------------------------
PIXABAY_KEY=00000000-0000000000000000        # pixabay.com/api/docs
PEXELS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # pexels.com/api
UNSPLASH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # unsplash.com/developers
# NASA / ESA: gratis, requiere clave en api.nasa.gov
NASA_KEY=DEMO_KEY


# ------------------------------------------------------------
# 6) PENDIENTE — conectores aun no implementados
#    (ver docs/DESARROLLO.md, seccion "Proximos pasos")
# ------------------------------------------------------------
# Instagram / Facebook (Meta Graph API)
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
# FACEBOOK_PAGE_ID=
# INSTAGRAM_BUSINESS_ID=

# TikTok (Content Posting API)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback
